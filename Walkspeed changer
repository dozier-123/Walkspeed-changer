local Player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")

-- WalkSpeed variables
local currentSpeed = 16
local permanentEnabled = true
local Humanoid
local enforceConnection

-- Get Humanoid
local function getHumanoid()
	local char = Player.Character or Player.CharacterAdded:Wait()
	return char:WaitForChild("Humanoid")
end

-- Apply WalkSpeed manually
local function applySpeed()
	if Humanoid then
		Humanoid.WalkSpeed = currentSpeed
	end
end

-- Start Heartbeat enforcement
local function startEnforcing()
	if enforceConnection then enforceConnection:Disconnect() end
	enforceConnection = RunService.Heartbeat:Connect(function()
		if permanentEnabled and Humanoid then
			if Humanoid.WalkSpeed ~= currentSpeed then
				Humanoid.WalkSpeed = currentSpeed
			end
		end
	end)
end

-- Stop Heartbeat enforcement
local function stopEnforcing()
	if enforceConnection then
		enforceConnection:Disconnect()
		enforceConnection = nil
	end
end

-- Initialize
Humanoid = getHumanoid()
applySpeed()
if permanentEnabled then startEnforcing() end

-- Reapply on respawn
Player.CharacterAdded:Connect(function(char)
	Humanoid = char:WaitForChild("Humanoid")
	if permanentEnabled then startEnforcing() end
end)

