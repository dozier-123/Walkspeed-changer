-- Toggle logic
Toggle.MouseButton1Click:Connect(function()
	permanentEnabled = not permanentEnabled
	if permanentEnabled then
		startEnforcing()
	else
		stopEnforcing()
	end
	Toggle.Text = "Permanent: " .. (permanentEnabled and "ON" or "OFF")
end)

-- Change WalkSpeed instantly
Box.FocusLost:Connect(function()
	local speed = tonumber(Box.Text)
	if speed then
		currentSpeed = math.clamp(speed, 1, 500)
		applySpeed()
	end
	Box.Text = ""
end)

-- Minimize Logic
local minimized = false
Minimize.MouseButton1Click:Connect(function()
	minimized = not minimized
	Box.Visible = not minimized
	Toggle.Visible = not minimized
	Frame.Size = minimized and UDim2.new(0, 210, 0, 32) or UDim2.new(0, 210, 0, 130)
end)